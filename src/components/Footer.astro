---
const today = new Date();
---

<footer
	class="mt-24 pt-10 pb-20 px-4 text-center"
	style="background-color: var(--bg-secondary); color: var(--text-muted); border-top: 1px solid var(--border-subtle);"
>
	<div class="max-w-3xl mx-auto">
		<div class="ornament mb-6" aria-hidden="true">
			<span class="ornament-mark" style="color: var(--text-muted);">&#8258;</span>
		</div>
		<p class="text-xs" style="font-family: var(--font-body); letter-spacing: 0.05em;">
			&copy; {today.getFullYear()} Gary Peck &middot;
			<a href="/blog/rss.xml" class="no-underline" style="color: var(--text-muted);"
				onmouseover="this.style.color='var(--ember)'"
				onmouseout="this.style.color='var(--text-muted)'"
			>RSS</a>
		</p>
	</div>
</footer>
