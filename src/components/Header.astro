---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';

const [glorious, ...rest] = SITE_TITLE.split(' ');
const oblivion = rest.join(' ');
---

<header
	class="m-0 px-6 backdrop-blur-md sticky top-0 z-50 border-b"
	style="background-color: color-mix(in srgb, var(--bg-primary) 85%, transparent); border-color: var(--border-subtle);"
>
	<nav class="flex items-center justify-between max-w-6xl mx-auto py-4">
		<a
			href="/"
			class="wordmark text-xl md:text-2xl no-underline"
			aria-label={SITE_TITLE}
		>
			<span class="wordmark-glorious">{glorious}</span><span class="wordmark-oblivion">{oblivion}</span>
		</a>
		<div class="flex items-center gap-1">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog/">Writing</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
		</div>
		<div class="social-links flex items-center gap-2 max-sm:hidden">
			<ThemeToggle />
		</div>
	</nav>
</header>
