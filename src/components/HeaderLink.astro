---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '') + '/';
---

<a
	href={href}
	class:list={[
		className,
		'header-link inline-block no-underline py-2 px-3 text-sm tracking-wide',
		{ 'is-active': isActive },
	]}
	style={`color: ${isActive ? 'var(--moss)' : 'var(--text-secondary)'};`}
	onmouseover={`this.style.color='var(--moss)'`}
	onmouseout={`this.style.color='${isActive ? 'var(--moss)' : 'var(--text-secondary)'}'`}
	{...props}
>
	<slot />
</a>

<style>
	.header-link {
		font-family: var(--font-body);
		position: relative;
	}
	.header-link.is-active::after {
		content: '';
		position: absolute;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0.25rem;
		height: 1px;
		background-color: var(--moss);
	}
</style>
