---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`About — ${SITE_TITLE}`} description="About this site and its author.">
	<header class="text-center mb-10">
		<p class="eyebrow mb-4">Colophon</p>
		<h1 class="text-4xl md:text-5xl mb-4" style="font-family: var(--font-display);">
			About <em class="italic" style="color: var(--ember);">Glorious Oblivion</em>
		</h1>
		<div class="ornament" aria-hidden="true">
			<span class="ornament-mark">&#8258;</span>
		</div>
	</header>

	<div class="prose prose-lg max-w-none">
		<p>
			This is the personal weblog of Gary Peck — a software developer who
			has kept a small site here, off and on, since 2007.
		</p>

		<p>
			Most of what's here is technical: workarounds, configurations,
			fragments of solutions I wanted to keep where I could find them again.
			The rest is whatever else seemed worth writing down at the time.
		</p>

		<h2>The site</h2>
		<p>
			Built with <a href="https://astro.build">Astro</a>. Set in
			Atkinson Hyperlegible for body text and a system old-style serif for
			display. Hosted on GitHub Pages. No analytics, no trackers, no ads.
			There is an <a href="/blog/rss.xml">RSS feed</a>.
		</p>

		<h2>Contact</h2>
		<p>
			Corrections and kind words are welcome.
		</p>
	</div>
</BaseLayout>
