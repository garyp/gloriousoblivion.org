---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Group by year for the archive view
const postsByYear = posts.reduce((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	(acc[year] ||= []).push(post);
	return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout title={`Notes — ${SITE_TITLE}`} description={SITE_DESCRIPTION} containerWidth="wide">
	<header class="pt-6 pb-10 text-center">
		<p class="eyebrow mb-4">All notes</p>
		<h1 class="text-4xl md:text-5xl mb-3" style="font-family: var(--font-display);">
			Everything, in <em class="italic">reverse</em>.
		</h1>
		<p class="text-base md:text-lg max-w-xl mx-auto" style="color: var(--text-secondary); font-family: var(--font-display);">
			{posts.length} notes, accumulated across the years.
		</p>
	</header>

	<div class="ornament mb-12" aria-hidden="true">
		<span class="ornament-mark">&#8258;</span>
	</div>

	<section>
		{years.map((year) => (
			<div class="mb-14">
				<h2
					class="text-3xl md:text-4xl mb-6 pb-2 flex items-baseline gap-4"
					style="font-family: var(--font-display); border-bottom: 1px solid var(--border-subtle);"
				>
					<span style="font-variant-numeric: oldstyle-nums; color: var(--moss);">{year}</span>
					<span class="text-sm" style="color: var(--text-muted); font-family: var(--font-body); font-style: normal;">
						&middot; {postsByYear[year].length} {postsByYear[year].length === 1 ? 'entry' : 'entries'}
					</span>
				</h2>
				<ul>
					{postsByYear[year].map((post) => (
						<li class="py-3 border-b last:border-b-0" style="border-color: var(--rule-soft, var(--border-subtle));">
							<a
								href={`/blog/${post.id}/`}
								class="group flex flex-col md:flex-row md:items-baseline md:gap-6 no-underline"
							>
								<time
									class="shrink-0 text-sm md:w-28 mb-1 md:mb-0"
									style="color: var(--text-muted); font-variant-numeric: oldstyle-nums; font-family: var(--font-display); font-style: italic;"
								>
									<FormattedDate date={post.data.pubDate} />
								</time>
								<div class="flex-1">
									<h3 class="text-lg md:text-xl leading-snug mb-1" style="font-family: var(--font-display); color: var(--text-primary);">
										<span
											class="group-hover:underline"
											style="text-decoration-color: var(--moss); text-underline-offset: 0.18em;"
										>{post.data.title}</span>
									</h3>
									{post.data.description && (
										<p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
											{post.data.description}
										</p>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</section>
</BaseLayout>
