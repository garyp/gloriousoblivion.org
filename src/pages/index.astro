---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="pt-6 pb-12">
		<p class="eyebrow mb-6">Est. 2007</p>
		<h1
			class="text-4xl md:text-6xl leading-[1.05] tracking-tight mb-8"
			style="font-family: var(--font-display);"
		>
			A record of what
			<em class="italic" style="color: var(--ember);">intrudes</em>.
		</h1>
		<p
			class="text-lg md:text-xl leading-relaxed max-w-2xl"
			style="color: var(--text-secondary); font-family: var(--font-display);"
		>
			A personal weblog by Gary Peck. Mostly technical notes,
			kept happily and intermittently since 2007.
		</p>
	</section>

	<div class="ornament my-10" aria-hidden="true">
		<span class="ornament-mark">&#8258;</span>
	</div>

	<section class="pb-12">
		<div class="flex items-baseline justify-between mb-6">
			<h2 class="kicker">Recent notes</h2>
			<a href="/blog/" class="text-sm no-underline" style="color: var(--text-muted);"
				onmouseover="this.style.color='var(--ember)'"
				onmouseout="this.style.color='var(--text-muted)'"
			>
				All notes &rarr;
			</a>
		</div>

		<ul class="divide-y" style="border-color: var(--border-subtle);">
			{recentPosts.map((post) => (
				<li class="py-4" style="border-color: var(--border-subtle);">
					<a href={`/blog/${post.id}/`} class="group flex flex-col md:flex-row md:items-baseline md:gap-6 no-underline">
						<time class="shrink-0 text-sm md:w-32 mb-1 md:mb-0" style="color: var(--text-muted); font-variant-numeric: oldstyle-nums;">
							<FormattedDate date={post.data.pubDate} />
						</time>
						<span class="block text-lg md:text-xl leading-snug" style="font-family: var(--font-display); color: var(--text-primary);">
							{post.data.title}
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>
